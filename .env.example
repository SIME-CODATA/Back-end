# ============================================================
# POSTGRESQL
# ============================================================
POSTGRES_DB=pdm_v2
POSTGRES_USER=pdm_admin
POSTGRES_PASSWORD=troque_esta_senha

# ============================================================
# CONTROLE DE E-MAIL
# Local: false para manter contas de teste.
# Servidor: true.
# ============================================================
ENFORCE_INSTITUTIONAL_EMAIL=false
ALLOWED_EMAIL_DOMAINS=prefeitura.sp.gov.br

# ============================================================
# SMAE
# ============================================================
SMAE_BASE_URL=https://smae.prefeitura.sp.gov.br/api
SMAE_EMAIL=
SMAE_PASSWORD=
SMAE_SYSTEMS=SMAE,ProgramaDeMetas,PDM,CasaCivil,Projetos,PlanoSetorial,MDO
SMAE_PDM_ID=32

# ============================================================
# PRODUÇÃO / TRAEFIK
# HOST_NAME é o DNS, sem http://, https:// ou @.
# Exemplo fictício: pdm.codata.prefeitura.sp.gov.br
# ============================================================
HOST_NAME=
LE_EMAIL=projetos.codata@prefeitura.sp.gov.br
LE_ACME_URL=https://acme-v02.api.letsencrypt.org/directory
